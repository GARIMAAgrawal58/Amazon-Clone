<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Amazon Admin Dashboard</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts - Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            @apply bg-gray-100;
        }
    </style>
</head>
<body class="flex min-h-screen">

    <!-- Mobile Menu Button -->
    <button id="menu-button" class="md:hidden fixed top-4 left-4 z-50 p-2 bg-white rounded-lg shadow-md text-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-500">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
    </button>

    <!-- Sidebar -->
    <nav id="sidebar" class="bg-gray-800 text-white w-64 min-h-screen p-4 flex flex-col space-y-4 transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out fixed md:relative z-40 shadow-xl">
        <div class="flex items-center space-x-2 p-2 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shopping-cart text-yellow-400"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
            <h1 class="text-2xl font-bold">Admin Dashboard</h1>
        </div>

        <ul class="flex flex-col space-y-2">
            <li>
                <a href="vusers" class="flex items-center space-x-2 p-3 text-gray-300 hover:bg-gray-700 hover:text-white rounded-lg transition-colors duration-200">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users"><path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    <span>Users</span>
                </a>
            </li>
            <li>
                <a href="addproduct" class="flex items-center space-x-2 p-3 text-gray-300 hover:bg-gray-700 hover:text-white rounded-lg transition-colors duration-200">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-package"><path d="m7.5 4.27v17.5a1.25 1.25 0 0 0 1.25 1.25h6.5a1.25 1.25 0 0 0 1.25-1.25V4.27"/><path d="M12 2v20"/><path d="M15 2H9"/><path d="M6 10h12"/><path d="M6 14h12"/><path d="M6 18h12"/></svg>
                    <span>Products</span>
                </a>
            </li>
            <li>
                <a href="vproducts" class="flex items-center space-x-2 p-3 text-gray-300 hover:bg-gray-700 hover:text-white rounded-lg transition-colors duration-200">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                    <span>View Products</span>
                </a>
            </li>
            <li>
                <a href="venq" class="flex items-center space-x-2 p-3 text-gray-300 hover:bg-gray-700 hover:text-white rounded-lg transition-colors duration-200">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-pen"><path d="M12 11h.01"/><path d="M16 11h.01"/><path d="M18 11h.01"/><path d="M16.5 3.5c-.75-.79-2-.84-2.82-.19L9 7l2 2L16 4.67c.65-.82.6-2.07-.19-2.82L16.5 3.5Z"/><path d="M4 19.5V10c0-.5.2-1 .6-1.4L13 1h6.4c.8-.8 1.6-1.6 2.4-2.4a.5.5 0 0 0-.2-.6L18 3.5"/><path d="M17 14v6H4.2c-1.13 0-2.2-.84-2.2-2V7.8c0-1.12.87-2.16 2-2.16h5.8"/></svg>
                    <span>Enquiry</span>
                </a>
            </li>
            <li>
                <a href="vorders" class="flex items-center space-x-2 p-3 text-gray-300 hover:bg-gray-700 hover:text-white rounded-lg transition-colors duration-200">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-truck"><path d="M14 18h1c4.42 0 7-2.58 7-7V6c0-1.66-.4-3.67-2.7-4.9-.7-.4-1.5-.7-2.3-.9c-.6-.2-1.3-.2-1.9-.2H6.9c-.6 0-1.3 0-1.9.2c-.8.2-1.6.5-2.3.9C2.4 2.33 2 4.34 2 6v5c0 4.42 2.58 7 7 7h1c0 1.1 1.9 2 4 2"/><path d="M18 18.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0Z"/><path d="M10 18.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0Z"/><path d="M12 18v2.5"/><path d="M12 14v4"/><path d="M14 14.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0Z"/></svg>
                    <span>Orders</span>
                </a>
            </li>
        </ul>

        <div class="mt-auto flex flex-col space-y-2">
            <li>
                <a href="settings" class="flex items-center space-x-2 p-3 text-gray-300 hover:bg-gray-700 hover:text-white rounded-lg transition-colors duration-200">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-settings"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.26.43a2 2 0 0 0 .73 2.73l.08.15a2 2 0 0 1 0 2l-.08.15a2 2 0 0 0-.73 2.73l.26.43a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.26-.43a2 2 0 0 0-.73-2.73l-.08-.15a2 2 0 0 1 0-2l.08-.15a2 2 0 0 0 .73-2.73l-.26-.43a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
                    <span>Settings</span>
                </a>
            </li>
            <li>
                <a href="logout" class="flex items-center space-x-2 p-3 text-red-400 hover:bg-gray-700 hover:text-red-300 rounded-lg transition-colors duration-200">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-log-out"><path d="M18 10v6a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2v-6"/><path d="M12 2l-6 6h4v12h4V8h4l-6-6Z"/></svg>
                    <span>Logout</span>
                </a>
            </li>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main class="flex-1 p-8 md:p-12 transition-all duration-300 ease-in-out">
        <header class="flex flex-col md:flex-row md:items-center justify-between mb-8">
            <h2 class="text-4xl font-bold text-gray-900 mb-2 md:mb-0">Dashboard Overview</h2>
            <div class="flex items-center space-x-4">
                <div>Welcome <%= aname %></div>
                <img class="w-10 h-10 rounded-full border-2 border-yellow-400" src="https://placehold.co/40x40/E8E8E8/454545?text=A" alt="Admin avatar">
            </div>
        </header>

        <!-- Stats Cards -->
        
            
           
          <div class="grid grid-cols-1 gap-6 mb-8">
  <div class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300">
    <div class="flex flex-col space-y-4">
      <div class="p-3 bg-blue-100 rounded-xl">

                       <h1 class="text-lg font-semibold mb-4" align="center"><u>Products</u></h1>
        <table border="10" class="w-full text-left">

    <tr>
        
        <th>Product Id</th>
        <th>Product Name</th>
        <th>Category</th>
        <th>Quantity</th>
        <th>Price</th>
        <th>Description</th>
        <th>Image</th>
        <th>Action</th>
    </tr>
    <% data.forEach((entry) => { %>
        <tr>
            <td><%= entry.pid %></td>
            <td><%= entry.pname %></td>
            <td><%= entry.category %></td>
            <td><%= entry.quantity %></td>
            <td><%= entry.price %></td>
            <td><%= entry.description %></td>
            <td><img src="<%= entry.image %>" height="60" width="60"></td>
            <td><a href="delproduct?id=<%=entry.pid %>" style="color: blue;">Delete</a></td>
            
        </tr>
    <% }) %>
</table>
                        </table>
                    </div>
                    
                </div>
            </div>

        
    </main>

    <!-- JavaScript for Mobile Menu Toggle -->
    <script>
        const menuButton = document.getElementById('menu-button');
        const sidebar = document.getElementById('sidebar');

        menuButton.addEventListener('click', () => {
            sidebar.classList.toggle('-translate-x-full');
        });
    </script>

</body>
</html>
